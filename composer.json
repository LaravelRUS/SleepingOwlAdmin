{
    "name": "laravelrus/sleepingowl",
    "description": "Administrative interface builder for Laravel.",
    "homepage": "https://github.com/LaravelRUS/SleepingOwlAdmin",
    "keywords": [
        "laravel",
        "admin",
        "administrator",
        "crud",
        "panel"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/LaravelRUS/SleepingOwlAdmin/issues",
        "source": "https://github.com/LaravelRUS/SleepingOwlAdmin"
    },
    "authors": [
        {
            "name": "Sleeping Owl",
            "email": "owl.sleeping@yahoo.com"
        },
        {
            "name": "Pavel Buchnev",
            "email": "butschster@gmail.com"
        },
        {
            "name": "Dave Gabrielyan",
            "email": "aioslike@gmail.com"
        },
        {
            "name": "TheArdent",
            "email": "oleksii.yaryi@gmail.com"
        },
        {
            "name": "Daan",
            "email": "daan@ukr.net"
        }
    ],
    "require": {
        "php": ">=8.1",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
        "doctrine/dbal": "^3.0|^4.0",
        "erusev/parsedown": "1.*",
        "diglactic/laravel-breadcrumbs": "^8.0|^9.0|^10.0"
    },
    "require-dev": {
        "phpunit/phpunit": ">=10.0",
        "mockery/mockery": "^1.4",
        "orchestra/testbench": ">=8",
        "barryvdh/laravel-ide-helper": ">=2.4"
    },
    "autoload": {
        "psr-4": {
            "SleepingOwl\\Admin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SleepingOwl\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-development": "12.x-dev"
        },
        "laravel": {
            "providers": [
                "SleepingOwl\\Admin\\Providers\\SleepingOwlServiceProvider"
            ]
        }
    },
    "archive": {
        "exclude": [
            "/.idea",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/node_modules",
            "/test-results",
            "/vendor"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
