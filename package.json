{
    "private": true,
    "scripts": {
        "development": "node scripts/modernization/build-vite-profile.mjs development",
        "dev": "node scripts/modernization/build-vite-profile.mjs development",
        "watch": "node scripts/modernization/build-vite-profile.mjs development --watch",
        "watch-poll": "node scripts/modernization/build-vite-profile.mjs development --watch --poll",
        "hot": "node scripts/modernization/build-vite-profile.mjs development --watch",
        "production": "node scripts/modernization/build-asset-profiles.mjs",
        "prod": "node scripts/modernization/build-asset-profiles.mjs",
        "check": "npm run format:check && npm run lint && npm run lint:styles && npm run check:reachability && npm test",
        "check:reachability": "node scripts/modernization/check-source-reachability.mjs",
        "check:ci": "npm run check && npm run test:e2e",
        "format": "prettier --write \"resources/js/**/*.js\" \"resources/js/shared/legacy/**/*.vue\" \"tests/frontend/**/*.{html,js,mjs}\" \"scripts/modernization/*.mjs\" eslint.config.mjs playwright.config.mjs stylelint.config.mjs vite.config.mjs vitest.config.mjs",
        "format:check": "prettier --check \"resources/js/**/*.js\" \"resources/js/shared/legacy/**/*.vue\" \"tests/frontend/**/*.{html,js,mjs}\" \"scripts/modernization/*.mjs\" eslint.config.mjs playwright.config.mjs stylelint.config.mjs vite.config.mjs vitest.config.mjs",
        "lint": "eslint resources/js tests/frontend scripts/modernization/*.mjs eslint.config.mjs playwright.config.mjs stylelint.config.mjs vite.config.mjs vitest.config.mjs",
        "lint:fix": "npm run lint -- --fix",
        "lint:styles": "stylelint \"resources/css/**/*.scss\" --allow-empty-input",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:install": "playwright install chromium",
        "test:watch": "vitest",
        "report:bundles": "node scripts/modernization/report-adminlte-bundles.mjs",
        "report:tabler-bundles": "node scripts/modernization/report-tabler-bundles.mjs",
        "baseline:frontend": "node scripts/modernization/capture-frontend-baseline.mjs",
        "baseline:config": "php scripts/modernization/capture-config-inventory.php",
        "baseline:config:validate": "php scripts/modernization/validate-config-migration-matrix.php",
        "baseline:config:fixtures:validate": "php scripts/modernization/validate-config-fixtures.php"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@popperjs/core": "2.11.8",
        "@tabler/core": "1.5.1",
        "admin-lte": "4.9.1",
        "air-datepicker": "3.6.0",
        "autoprefixer": "^10.5.5",
        "axios": "^1.20.0",
        "bootstrap": "5.3.8",
        "datatables.net": "3.0.3",
        "datatables.net-bs5": "3.0.3",
        "datatables.net-responsive": "4.0.3",
        "datatables.net-responsive-bs5": "4.0.3",
        "dropzone": "^6.2.0",
        "glightbox": "3.3.1",
        "js-cookie": "^3.0.8",
        "lazyload": "^2.0.0-rc.2",
        "lodash": "^4.18.1",
        "progressbar.js": "^1.1.1",
        "sortablejs": "^1.15.7",
        "sweetalert2": "^11.26.25",
        "tom-select": "^2.6.2",
        "vue": "3.5.42",
        "vue-multiselect": "3.5.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.63.0",
        "@tailwindcss/postcss": "4.3.3",
        "@vitejs/plugin-vue": "6.0.8",
        "@vue/compiler-sfc": "3.5.42",
        "esbuild": "0.28.2",
        "eslint": "10.10.0",
